# =============================================================================
# 环境变量模板 - python_ai_talk
# 业务上游（history 等）URL：不在此配置，在 /console 按 A Token 手配
# 对外调智能体：本服务 /agent-gate（多 G）；勿把裸 OpenClaw 当公网入口
# 飞轮默认进程内：不必配置 FLYWHEEL_BASE_URL（空=本机 Chroma）
# =============================================================================

# --- 镜像 / ACR（compose pull 用）---
REGISTRY=crpi-lff3xynwzvqxxxjk-vpc.cn-hangzhou.personal.cr.aliyuncs.com/pangbao-test
IMAGE_TAG=v2.0.7-beta.43
ACR_USERNAME=your_acr_username
ACR_PASSWORD=your_acr_password

# --- 控制面 MySQL（与 Go 同址；表前缀 agent_）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pangbao_agent

# --- 管理后台 /console ---
# Cookie 签名密钥（务必改成长随机串）
CONSOLE_SECRET_KEY=change-me-console-secret
# 首次启动写入/校验的管理员账密
AGENT_ADMIN_USERNAME=admin
AGENT_ADMIN_PASSWORD=admin-change-me

# --- 门禁转发内部 OpenClaw（多 G 在 DB；此处仅内部单 secret）---
INTERNAL_GATEWAY_URL=http://127.0.0.1:18789
INTERNAL_GATEWAY_TOKEN=dev-token-change-me

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI 密钥（tools 侧可用；选型仍可由 Go 注入）---
DEEPSEEK_API_KEY=your_deepseek_api_key
GLM_API_KEY=your_glm_api_key

# --- 向量库 ---
CHROMA_PERSIST_DIR=/app/data/chroma_db
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 启动时清空意图缓存 feeding_intents（默认关；清完务必改回 false）
CLEAR_FEEDING_INTENTS_ON_STARTUP=false
