# =============================================================================
# 环境变量模板 - python_ai_talk 仓（含双微服务）
# 服务：python-ai-talk（8000）+ python-prediction（8001）
# 命名规范：三层一致（.env 文件、docker-compose 注入、python 应用读取同名变量）
# =============================================================================
# 使用方式：
#   1. 复制本文件为对应环境的 .env 文件：
#      cp .env.example env/.env.local   # 本地开发
#      cp .env.example env/.env.test    # 测试环境
#      cp .env.example env/.env.prod    # 生产环境
#   2. 修改对应文件中的变量值
#   3. 启动服务（详见 docs/deploy-guide.md）
# =============================================================================

# --- 镜像配置（仅测试/生产环境需要）---
# 两服务分版本部署：各自钉 ACR tag（不含 CI 的 +talk/+prediction 后缀）
# ACR 命名空间下需预建仓库：python-ai-talk、python-prediction
# 发版示例：只升 prediction → 改 PYTHON_PREDICTION_IMAGE_TAG，不必动 talk
REGISTRY=crpi-lff3xynwzvqxxxjk-vpc.cn-hangzhou.personal.cr.aliyuncs.com/pangbao-test
PYTHON_AI_TALK_IMAGE_TAG=v2.0.7-beta.43
PYTHON_PREDICTION_IMAGE_TAG=v0.0.1
# 过渡期：未设 PYTHON_AI_TALK_IMAGE_TAG 时 compose 可回退到 IMAGE_TAG（仅 talk）
# 共用 IMAGE_TAG 已废弃为双服务默认，请勿再依赖它拉 prediction
IMAGE_TAG=v2.0.7-beta.43
ACR_USERNAME=your_acr_username
ACR_PASSWORD=your_acr_password

# --- 兄弟仓服务地址 ---
# 本地开发：http://host.docker.internal:9801
# 测试/生产：http://history-service:9801
HISTORY_SERVICE_URL=http://host.docker.internal:9801
DEVICE_SERVICE_URL=http://host.docker.internal:9803
VOICE_SERVICE_URL=http://host.docker.internal:9802
# 与 go_ai_talk voice internal 同源；空则进行中 ETA 拉取降级为无
DEVICE_GATEWAY_INTERNAL_SECRET=gateway-internal-change-me

# --- 同仓 python-prediction（预留；talk 应用本轮可不读取）---
# compose 同网默认：http://python-prediction:8001
PYTHON_PREDICTION_URL=http://python-prediction:8001

# --- Redis 配置 ---
# 本地开发：redis://localhost:6379/0
# 测试环境：redis://redis-test:6379/0
# 生产环境：redis://redis-node-1:7001,redis-node-2:7002,redis-node-3:7003
REDIS_URL=redis://localhost:6379/0

# --- AI：密钥（必填，与 go_ai_talk 兄弟仓共用）---
DEEPSEEK_API_KEY=your_deepseek_api_key
GLM_API_KEY=your_glm_api_key

# --- 向量数据库 ---
CHROMA_PERSIST_DIR=/app/data/chroma_db
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- 事件短说法库：启动一次性清空 feeding_intents（默认关；清完务必改回 false）---
# 发版：true 启动清空 → 改 false → python scripts/seed_event_phrases_from_dict.py 灌种
CLEAR_FEEDING_INTENTS_ON_STARTUP=false
# --- 意图缓存：启动一次性把 payload 旧备注键写入 remark（仅 Chroma；默认关；迁完改回 false）---
MIGRATE_INTENT_REMARK_KEYWORD_ON_STARTUP=false
