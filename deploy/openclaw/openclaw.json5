// OpenClaw Gateway 配置草稿
// History 经 Python tools；多 G 对外走 Python /agent-gate
{
  gateway: {
    port: 18789,
    bind: "loopback",
    auth: {
      mode: "token",
      token: "REPLACE_ME",
    },
    http: {
      endpoints: {
        chatCompletions: { enabled: true },
      },
    },
  },
  plugins: {
    load: {
      paths: ["./plugins/pangbao-tools"],
    },
    entries: {
      "pangbao-tools": {
        enabled: true,
        config: {
          // 仅 Python tools 基址；租户上游 URL 在控制台按 A 配置
          toolsBaseUrl: "http://127.0.0.1:8000/v1",
        },
      },
    },
  },
  agents: {
    defaults: {
      workspace: "./workspaces/default",
    },
    entries: {
      intent: {
        workspace: "./workspaces/intent",
        tools: {
          allow: [
            "history_create",
            "history_update",
            "history_delete",
            "history_end_latest",
            "history_filter",
            "history_list",
            "history_options",
            "baby_profile",
            "flywheel_intent_retrieve",
            "flywheel_intent_record",
          ],
        },
      },
      clinic: {
        workspace: "./workspaces/clinic",
        tools: {
          allow: [
            "history_filter",
            "history_list",
            "baby_profile",
            "flywheel_clinic_retrieve",
            "flywheel_clinic_record",
            "clinic_judge_implicit_acceptance",
          ],
        },
      },
      care_alert: {
        workspace: "./workspaces/care_alert",
        tools: {
          allow: [
            "history_filter",
            "history_list",
            "history_options",
            "baby_profile",
            "emit_care_cards",
          ],
        },
      },
    },
  },
}
