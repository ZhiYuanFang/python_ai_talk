// OpenClaw Gateway 配置草稿（任务 1.2 / 2.1）
// 钉死发行版：openclaw@2026.7.1-2；端口默认 18789
// 复制到 Gateway 主机 ~/.openclaw/openclaw.json 或通过 OPENCLAW_CONFIG 指定
{
  gateway: {
    port: 18789,
    bind: "loopback",
    auth: {
      mode: "token",
      // 生产用环境变量 OPENCLAW_GATEWAY_TOKEN，勿提交真实 token
      token: "REPLACE_ME",
    },
    http: {
      endpoints: {
        // Go 主路径：OpenAI 兼容 HTTP
        chatCompletions: { enabled: true },
      },
    },
  },
  // 本地插件：先 npm install && npm run build，再 openclaw plugins install ./plugins/pangbao-tools
  plugins: {
    load: {
      paths: ["./plugins/pangbao-tools"],
    },
    entries: {
      "pangbao-tools": {
        enabled: true,
        config: {
          // 可用环境变量 PANGBAO_HISTORY_BASE_URL / PANGBAO_TOOLS_BASE_URL 覆盖
          historyBaseUrl: "http://127.0.0.1:9702",
          toolsBaseUrl: "http://127.0.0.1:8000/v1",
        },
      },
    },
  },
  agents: {
    defaults: {
      workspace: "./workspaces/default",
    },
    entries: {
      // HTTP model 路由：openclaw/intent|clinic|care_alert
      // workspace 规则见 ./workspaces/<id>/AGENTS.md
      intent: {
        workspace: "./workspaces/intent",
        tools: {
          allow: [
            "history_create",
            "history_update",
            "history_delete",
            "history_end_latest",
            "history_filter",
            "history_options",
            "baby_profile",
            "flywheel_intent_retrieve",
            "flywheel_intent_record",
          ],
        },
      },
      clinic: {
        workspace: "./workspaces/clinic",
        tools: {
          allow: [
            "history_filter",
            "history_list",
            "baby_profile",
            "knowledge_search",
            "clinic_judge_implicit_acceptance",
            "flywheel_clinic_retrieve",
            "flywheel_clinic_record",
          ],
        },
      },
      care_alert: {
        workspace: "./workspaces/care_alert",
        tools: {
          // 无飞轮；无写史
          allow: [
            "history_filter",
            "history_list",
            "baby_profile",
            "emit_care_cards",
          ],
        },
      },
    },
  },
}
